{
    "manifest_version": 3,
    "name": "Negative",
    "version": "1.0",
    "description": "An extension that inverts the colors of web pages.",
    "icons": {
        "128": "icons/icon128.png"
    },
    "action":{
        "default_popup": "popup.html"
    },
    "permissions": [
        "scripting",
        "activeTab",
        "tabs"
    ]
}